---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 · Page Not Found" description="The requested page could not be found or has expired.">
  <section class="hero" style="justify-content: flex-start; min-height: 60dvh; padding-top: 96px">
    <div>
      <span class="eyebrow">404</span>
      <h1 class="display hero__headline" style="font-size: clamp(2.4rem, 5vw, 3.6rem)">
        Page not found
      </h1>
      <p class="hero__sub">
        The page you requested doesn't exist. It may be an incorrect link, or an
        expired site that has already been deleted.
      </p>
      <div class="hero__cta-row">
        <a class="btn btn--primary" href="/#drop">Upload a site</a>
        <a class="btn btn--ghost" href="/">Home</a>
      </div>
    </div>
    <div class="drop-card" aria-hidden="true">
      <div class="film-holes"></div>
      <div class="drop-card__paper" style="padding: 26px 22px; text-align: center">
        <span class="mono" style="font-size: 0.68rem; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(25,26,33,.5)">expired · not found</span>
        <div style="margin-top: 14px; font-family: var(--font-display); font-size: 1.6rem">this site is <em style="color: var(--amber); font-style: normal">no longer</em> available</div>
      </div>
      <div class="film-holes"></div>
    </div>
  </section>
</BaseLayout>