---
import "../../styles/global.css";
import { hasAdminAuth } from "../../lib/admin-auth";
import { isAdminSession } from "../../lib/session";

const configured = await hasAdminAuth();
const authed = await isAdminSession(Astro.request);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Admin Dashboard · madethis.website</title>
    <meta name="color-scheme" content="dark" />
  </head>
  <body class="admin-page">
    <main class={`admin ${authed ? "admin--wide" : ""}`}>
      <header class="admin__head">
        <div class="admin__head-left">
          <a class="admin__brand" href="/">madethis.website</a>
          <span class="admin__tag">admin dashboard</span>
        </div>
        {authed && (
          <div class="admin__head-nav">
            <a class="btn btn--ghost admin__head-btn" href="/">View Site</a>
            <a class="btn btn--ghost admin__head-btn" href="/docs/api">API Docs</a>
            <button class="btn btn--ghost admin__head-btn" id="logout-btn" type="button">Sign out</button>
          </div>
        )}
      </header>

      {!configured ? (
        <section class="admin__card">
          <h1>Create admin</h1>
          <p class="admin__lede">First visit only: choose a username and password. No environment variables required.</p>
          <form class="admin__form" id="setup-form">
            <label>
              <span>Username</span>
              <input name="username" type="text" value="admin" autocomplete="username" required />
            </label>
            <label>
              <span>Password</span>
              <input name="password" type="password" autocomplete="new-password" minlength="8" required />
            </label>
            <label>
              <span>Confirm password</span>
              <input name="confirm" type="password" autocomplete="new-password" minlength="8" required />
            </label>
            <p class="admin__error" id="setup-error" hidden></p>
            <button class="btn btn--primary" type="submit">Create admin &amp; continue</button>
          </form>
        </section>
      ) : !authed ? (
        <section class="admin__card">
          <h1>Sign in</h1>
          <p class="admin__lede">Protected area for site management, upload logs, and API key configuration.</p>
          <form class="admin__form" id="login-form">
            <label>
              <span>Username</span>
              <input name="username" type="text" autocomplete="username" required />
            </label>
            <label>
              <span>Password</span>
              <input name="password" type="password" autocomplete="current-password" required />
            </label>
            <p class="admin__error" id="login-error" hidden></p>
            <button class="btn btn--primary" type="submit">Sign in</button>
          </form>
        </section>
      ) : (
        <section class="admin__dashboard">
          <!-- Metrics Bar -->
          <div class="admin__metrics" id="metrics-bar">
            <div class="metric-card">
              <div class="metric-card__title">Active Sites</div>
              <div class="metric-card__val" id="metric-active">-</div>
              <div class="metric-card__sub" id="metric-total-uploads">Loading uploads…</div>
            </div>
            <div class="metric-card">
              <div class="metric-card__title">Live Storage</div>
              <div class="metric-card__val" id="metric-storage">-</div>
              <div class="metric-card__sub" id="metric-storage-sub">Vercel Blob (500MB free tier)</div>
            </div>
            <div class="metric-card">
              <div class="metric-card__title">Total Visits</div>
              <div class="metric-card__val" id="metric-visits">-</div>
              <div class="metric-card__sub">Best-effort, throttled writes</div>
            </div>
            <div class="metric-card">
              <div class="metric-card__title">CLI Uploads</div>
              <div class="metric-card__val" id="metric-cli-count">-</div>
              <div class="metric-card__sub" id="metric-web-count">Terminal &amp; automation</div>
            </div>
          </div>

          <!-- Navigation Tabs.
               Future-proof: to add a tab, add its id to TABS in the script
               below and a matching section with id="tab-<id>". Hash routing
               (#/logs), ARIA roles, and arrow-key nav come for free. -->
          <div class="admin__tabs" role="tablist" aria-label="Admin sections">
            <button class="admin__tab is-active" role="tab" id="tabbtn-logs" aria-controls="tab-logs" aria-selected="true" data-tab="logs" type="button">Uploads</button>
            <button class="admin__tab" role="tab" id="tabbtn-keys" aria-controls="tab-keys" aria-selected="false" data-tab="keys" type="button" tabindex="-1">API Keys</button>
            <button class="admin__tab" role="tab" id="tabbtn-security" aria-controls="tab-security" aria-selected="false" data-tab="security" type="button" tabindex="-1">Security</button>
          </div>

          <!-- TAB 1: Uploads -->
          <div class="admin__tab-panel is-active" id="tab-logs" role="tabpanel" aria-labelledby="tabbtn-logs" tabindex="0">
            <div class="admin__toolbar">
              <div class="admin__filters">
                <input type="text" class="admin__search-input" id="log-search" placeholder="Search slug, IP, location…" maxlength="100" />
                <select class="admin__filter-select" id="log-source" aria-label="Filter by source">
                  <option value="all">All sources</option>
                  <option value="cli">CLI</option>
                  <option value="website">Website</option>
                  <option value="api">API</option>
                </select>
                <select class="admin__filter-select" id="log-status" aria-label="Filter by status">
                  <option value="all">Active + expired</option>
                  <option value="active">Active only</option>
                  <option value="expired">Expired only</option>
                </select>
                <button class="btn btn--ghost admin__toggle-btn" id="grace-filter-btn" type="button" aria-pressed="false">
                  Top 3 grace
                </button>
              </div>
              <div class="admin__filters" style="flex: 0 0 auto; min-width: 0;">
                <button class="btn btn--ghost admin__toolbar-btn" id="purge-expired-btn" type="button" title="Delete up to 50 expired sites and their log rows">
                  Purge expired
                </button>
                <button class="btn btn--ghost admin__toolbar-btn" id="refresh-logs-btn" type="button">
                  Refresh
                </button>
              </div>
            </div>

            <div class="admin__table-wrap">
              <table class="admin__table">
                <thead>
                  <tr>
                    <th scope="col">Uploaded</th>
                    <th scope="col">Site</th>
                    <th scope="col">Source</th>
                    <th scope="col">IP &amp; Location</th>
                    <th scope="col">Visits</th>
                    <th scope="col">Expires</th>
                    <th scope="col" style="text-align: right;">Actions</th>
                  </tr>
                </thead>
                <tbody id="logs-tbody">
                  <tr>
                    <td colspan="7" class="admin__table-state">
                      Loading uploads…
                    </td>
                  </tr>
                </tbody>
              </table>
            </div>

            <div class="admin__pagination">
              <div id="pagination-info">Showing 0 of 0 items</div>
              <div class="admin__page-btns">
                <select class="admin__limit-select" id="log-limit" aria-label="Rows per page">
                  <option value="10">10 / page</option>
                  <option value="25">25 / page</option>
                  <option value="50">50 / page</option>
                </select>
                <button class="btn btn--ghost admin__page-btn" id="prev-page-btn" type="button" disabled>Prev</button>
                <span class="admin__page-num" id="current-page-num">1</span>
                <button class="btn btn--ghost admin__page-btn" id="next-page-btn" type="button" disabled>Next</button>
              </div>
            </div>
          </div>

          <!-- TAB 2: API Keys -->
          <div class="admin__tab-panel" id="tab-keys" role="tabpanel" aria-labelledby="tabbtn-keys" tabindex="0" hidden>
            <section class="admin__card">
              <div class="admin__row">
                <h1>API Keys</h1>
              </div>
              <p class="admin__lede">
                Named bearer tokens for CLI and API uploads. Keys are shown once at creation,
                stored hashed, and listed masked. Revoking one key never affects the others.
              </p>

              <div class="admin__showonce" id="key-showonce" hidden>
                <strong>Copy this key now — it will never be shown again.</strong>
                <code id="key-showonce-value"></code>
                <div class="admin__key-actions">
                  <button class="btn btn--ghost admin__toolbar-btn" id="key-showonce-copy" type="button">Copy</button>
                  <button class="btn btn--ghost admin__toolbar-btn" id="key-showonce-dismiss" type="button">Dismiss</button>
                </div>
              </div>

              <ul class="admin__keylist" id="keys-list">
                <li class="admin__table-state">Loading keys…</li>
              </ul>

              <form class="admin__create-row" id="key-create-form">
                <input class="admin__input" id="key-name-input" name="name" type="text" placeholder="New key name (e.g. laptop)" maxlength="40" autocomplete="off" required />
                <button class="btn btn--primary admin__toolbar-btn" type="submit">Create key</button>
              </form>
              <p class="admin__meta" id="key-meta">Maximum 10 keys. Last-used updates at most once per hour.</p>
              <p class="admin__error" id="key-error" hidden></p>

              <div class="admin__examples" style="margin-top: 24px;">
                <h2>CLI Quick Reference</h2>
                <h3>Single file or ZIP via cURL</h3>
                <pre class="admin__code"><code>curl -fsS -X POST "https://www.madethis.website/api/cli/upload?ttl=1h" \
  -H "Authorization: Bearer $MADETHIS_API_KEY" \
  -H "Content-Type: text/html; charset=utf-8" \
  --data-binary @plan.html</code></pre>
                <h3>JSON payload</h3>
                <pre class="admin__code"><code>curl -fsS -X POST "https://www.madethis.website/api/cli/upload" \
  -H "Authorization: Bearer $MADETHIS_API_KEY" \
  -H "Content-Type: application/json" \
  -d '&#123;"content": "# Hello World", "filename": "index.md", "ttl": 86400&#125;'</code></pre>
              </div>
            </section>
          </div>

          <!-- TAB 3: Security -->
          <div class="admin__tab-panel" id="tab-security" role="tabpanel" aria-labelledby="tabbtn-security" tabindex="0" hidden>
            <section class="admin__card">
              <h1>Security &amp; Free Tier Limits</h1>
              <p class="admin__lede">What is enforced, and what it costs on the free tier.</p>

              <div class="admin__formats">
                <h2>Authentication</h2>
                <ul>
                  <li><strong>Password hashing:</strong> Node.js <code>scryptSync</code> with random 16-byte salt.</li>
                  <li><strong>Sessions:</strong> HMAC-SHA256 signed, <code>HttpOnly</code>, <code>SameSite=Strict</code>, <code>Secure</code> in production, 7-day expiry.</li>
                  <li><strong>API keys:</strong> random 192-bit tokens, stored as SHA-256 hashes, masked in listings, revealed once at creation.</li>
                  <li><strong>CSRF:</strong> state-changing admin routes require <code>SameSite=Strict</code> cookies plus JSON content-type (forces CORS preflight cross-origin).</li>
                  <li><strong>Login rate limiting:</strong> max 5 attempts per 15 minutes per IP.</li>
                </ul>

                <h2>Uploads &amp; abuse</h2>
                <ul>
                  <li><strong>Upload rate limiting:</strong> global &amp; IP-based hourly limits on dropzone &amp; CLI routes.</li>
                  <li><strong>Visit counters:</strong> best-effort, throttled to one write per 5 minutes per site; range follow-ups (video scrubbing) are never counted.</li>
                  <li><strong>Key last-used:</strong> throttled to one write per hour per key.</li>
                </ul>

                <h2>Vercel free tier efficiency</h2>
                <ul>
                  <li><strong>Single-manifest logs:</strong> upload index is one rolling JSON file (<code>config/upload-logs.json</code>, max 1000 rows) — no per-site list queries in admin.</li>
                  <li><strong>Live-bytes meter:</strong> the storage card counts live sites only; expired rows don't inflate it.</li>
                  <li><strong>Automatic cleanup:</strong> expired sites are removed by Vercel Cron (<code>/api/cron/cleanup</code>); Purge Expired does the same on demand (max 50 per click).</li>
                </ul>
              </div>
            </section>
          </div>
        </section>

        <!-- Details modal -->
        <div class="admin__modal-backdrop" id="details-modal" hidden>
          <div class="admin__modal" role="dialog" aria-modal="true" aria-labelledby="details-title">
            <div class="admin__modal-head">
              <h3 class="admin__modal-title" id="details-title">Upload details</h3>
              <button class="btn-icon" id="close-modal-btn" type="button" aria-label="Close details">&times;</button>
            </div>
            <dl class="admin__detail-grid" id="modal-summary"></dl>
            <div class="admin__modal-grid">
              <div class="admin__modal-row">
                <label for="extend-select" style="font-size: 0.82rem; color: var(--muted);">Extend lifetime</label>
                <select class="admin__extend-select" id="extend-select">
                  <option value="3600">1 hour</option>
                  <option value="86400">24 hours</option>
                  <option value="604800">7 days</option>
                </select>
                <button class="btn btn--ghost admin__toolbar-btn" id="extend-apply-btn" type="button">Apply</button>
              </div>
              <div class="admin__modal-row">
                <button class="btn btn--ghost admin__toolbar-btn" id="modal-copy-btn" type="button">Copy URL</button>
                <button class="btn btn--ghost admin__toolbar-btn" id="modal-delete-btn" type="button" style="color: var(--danger); border-color: rgba(255,107,94,.4);">Delete site</button>
              </div>
            </div>
            <pre class="admin__code" style="max-height: 220px; overflow-y: auto; margin-top: 14px;"><code id="modal-json"></code></pre>
          </div>
        </div>
      )}
    </main>

    <script>
      // ---------- shared helpers ----------
      async function apiJson(path: string, init?: RequestInit): Promise<any> {
        const res = await fetch(path, init);
        const body = await res.json().catch(() => null);
        if (!res.ok) {
          const msg = body?.error?.message ?? body?.error?.code ?? `Request failed (${res.status})`;
          throw new Error(String(msg));
        }
        return body;
      }

      function flashButton(btn: HTMLElement | null, text: string, ms = 1400) {
        if (!btn) return;
        const orig = btn.textContent;
        btn.textContent = text;
        window.setTimeout(() => { btn.textContent = orig; }, ms);
      }

      // ---------- auth forms ----------
      const setupForm = document.getElementById("setup-form");
      const setupError = document.getElementById("setup-error");
      setupForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (setupError) setupError.hidden = true;
        const data = new FormData(setupForm as HTMLFormElement);
        try {
          await apiJson("/api/admin/setup", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              username: data.get("username"),
              password: data.get("password"),
              confirm: data.get("confirm"),
            }),
          });
          location.reload();
        } catch (err) {
          if (setupError) {
            setupError.textContent = err instanceof Error ? err.message : "Setup failed.";
            setupError.hidden = false;
          }
        }
      });

      const loginForm = document.getElementById("login-form");
      const loginError = document.getElementById("login-error");
      loginForm?.addEventListener("submit", async (e) => {
        e.preventDefault();
        if (loginError) loginError.hidden = true;
        const data = new FormData(loginForm as HTMLFormElement);
        try {
          await apiJson("/api/admin/login", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({
              username: data.get("username"),
              password: data.get("password"),
            }),
          });
          location.reload();
        } catch (err) {
          if (loginError) {
            loginError.textContent = err instanceof Error ? err.message : "Login failed.";
            loginError.hidden = false;
          }
        }
      });

      document.getElementById("logout-btn")?.addEventListener("click", async () => {
        await fetch("/api/admin/logout", { method: "POST" });
        location.reload();
      });

      // ---------- future-proof tabs ----------
      const TABS = ["logs", "keys", "security"];
      const tabButtons = new Map<string, HTMLButtonElement>();
      TABS.forEach((id) => {
        const btn = document.querySelector<HTMLButtonElement>(`.admin__tab[data-tab="${id}"]`);
        if (btn) tabButtons.set(id, btn);
      });

      function activateTab(id: string, push = true) {
        if (!tabButtons.has(id)) id = "logs";
        tabButtons.forEach((btn, key) => {
          const active = key === id;
          btn.classList.toggle("is-active", active);
          btn.setAttribute("aria-selected", String(active));
          btn.tabIndex = active ? 0 : -1;
          const panel = document.getElementById(`tab-${key}`);
          if (panel) {
            panel.classList.toggle("is-active", active);
            if (active) panel.removeAttribute("hidden");
            else panel.setAttribute("hidden", "");
          }
        });
        if (push) {
          try { location.hash = `#/${id}`; } catch { /* ignore */ }
        }
        if (id !== "keys") clearShowonce();
        if (id === "keys") void loadKeys();
        if (id === "logs") void loadLogs();
      }

      tabButtons.forEach((btn, id) => {
        btn.addEventListener("click", () => activateTab(id));
        btn.addEventListener("keydown", (e) => {
          if (e.key !== "ArrowRight" && e.key !== "ArrowLeft") return;
          e.preventDefault();
          const idx = TABS.indexOf(id);
          const next = e.key === "ArrowRight"
            ? TABS[(idx + 1) % TABS.length]
            : TABS[(idx - 1 + TABS.length) % TABS.length];
          activateTab(next);
          tabButtons.get(next)?.focus();
        });
      });

      window.addEventListener("hashchange", () => {
        const fromHash = location.hash.replace(/^#\/?/, "");
        if (tabButtons.has(fromHash)) activateTab(fromHash, false);
      });

      // ---------- API keys ----------
      type KeyRow = { id: string; name: string; prefix: string; createdAt: number; lastUsedAt: number | null };
      let keysLoaded = false;
      let showonceRaw: string | null = null;

      function keyRowNode(k: KeyRow): HTMLLIElement {
        const li = document.createElement("li");
        li.className = "admin__keyrow";

        const left = document.createElement("div");
        const name = document.createElement("div");
        name.className = "admin__keyname";
        name.textContent = k.name;
        const prefix = document.createElement("div");
        prefix.className = "admin__keyprefix";
        prefix.textContent = k.prefix;
        const sub = document.createElement("div");
        sub.className = "admin__keysub";
        const created = new Date(k.createdAt).toLocaleString();
        const used = k.lastUsedAt ? new Date(k.lastUsedAt).toLocaleString() : "never used";
        sub.textContent = `Created ${created} · Last used ${used}`;
        left.append(name, prefix, sub);

        const actions = document.createElement("div");
        actions.className = "admin__keyrow-actions";
        const copyBtn = document.createElement("button");
        copyBtn.className = "btn btn--ghost admin__toolbar-btn";
        copyBtn.type = "button";
        copyBtn.textContent = "Copy prefix";
        copyBtn.addEventListener("click", async () => {
          try {
            await navigator.clipboard.writeText(k.prefix);
            flashButton(copyBtn, "Copied");
          } catch { /* ignore */ }
        });
        const revokeBtn = document.createElement("button");
        revokeBtn.className = "btn btn--ghost admin__toolbar-btn";
        revokeBtn.type = "button";
        revokeBtn.textContent = "Revoke";
        (revokeBtn as HTMLElement).style.color = "var(--danger)";
        revokeBtn.addEventListener("click", () => void revokeKey(k));
        actions.append(copyBtn, revokeBtn);

        li.append(left, actions);
        return li;
      }

      async function loadKeys(force = false) {
        const list = document.getElementById("keys-list");
        if (!list || (keysLoaded && !force)) return;
        try {
          const data = await apiJson("/api/admin/api-key");
          const keys = (data.keys ?? []) as KeyRow[];
          keysLoaded = true;
          list.textContent = "";
          if (keys.length === 0) {
            const li = document.createElement("li");
            li.className = "admin__table-state";
            li.textContent = "No API keys yet — create one below.";
            list.append(li);
            return;
          }
          keys.forEach((k) => list.append(keyRowNode(k)));
        } catch {
          list.textContent = "";
          const li = document.createElement("li");
          li.className = "admin__table-state--error";
          li.textContent = "Could not load keys.";
          list.append(li);
        }
      }

      async function revokeKey(k: KeyRow) {
        if (!confirm(`Revoke key "${k.name}" (${k.prefix})? Existing uploads stay live; new uploads with it fail.`)) return;
        try {
          await apiJson("/api/admin/api-key", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: k.id }),
          });
          keysLoaded = false;
          await loadKeys(true);
        } catch (err) {
          const keyError = document.getElementById("key-error");
          if (keyError) {
            keyError.textContent = err instanceof Error ? err.message : "Revoke failed.";
            keyError.hidden = false;
          }
        }
      }

      document.getElementById("key-create-form")?.addEventListener("submit", async (e) => {
        e.preventDefault();
        const keyError = document.getElementById("key-error");
        if (keyError) keyError.hidden = true;
        const input = document.getElementById("key-name-input") as HTMLInputElement | null;
        const name = input?.value.trim() ?? "";
        if (!name) return;
        try {
          const data = await apiJson("/api/admin/api-key", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ name }),
          });
          showonceRaw = String(data.rawKey ?? "");
          const box = document.getElementById("key-showonce");
          const val = document.getElementById("key-showonce-value");
          if (box && val) {
            val.textContent = showonceRaw;
            box.hidden = false;
          }
          if (input) input.value = "";
          keysLoaded = false;
          await loadKeys(true);
        } catch (err) {
          if (keyError) {
            keyError.textContent = err instanceof Error ? err.message : "Create failed.";
            keyError.hidden = false;
          }
        }
      });

      function clearShowonce() {
        showonceRaw = null;
        const box = document.getElementById("key-showonce");
        const val = document.getElementById("key-showonce-value");
        if (val) val.textContent = "";
        if (box) box.hidden = true;
      }

      document.getElementById("key-showonce-copy")?.addEventListener("click", async (e) => {
        if (!showonceRaw) return;
        try {
          await navigator.clipboard.writeText(showonceRaw);
          flashButton(e.target as HTMLElement, "Copied");
        } catch { /* ignore */ }
      });
      document.getElementById("key-showonce-dismiss")?.addEventListener("click", clearShowonce);

      // ---------- uploads ----------
      type LogRow = {
        slug: string; createdAt: number; expiresAt: number; ttlSeconds?: number;
        graceActive?: boolean; bytes?: number; files?: number; homepage?: string | null;
        ip?: string; source?: string; userAgent?: string; country?: string;
        city?: string; region?: string; visits?: number; lastVisitAt?: number | null;
      };

      let currentPage = 1;
      let currentLimit = 10;
      let graceOnly = false;
      let currentRecords: LogRow[] = [];
      let modalSlug: string | null = null;

      function formatBytes(bytes: number): string {
        if (!bytes || bytes <= 0) return "0 B";
        const k = 1024;
        const sizes = ["B", "KB", "MB", "GB"];
        const i = Math.min(sizes.length - 1, Math.floor(Math.log(bytes) / Math.log(k)));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + " " + sizes[i];
      }

      function formatTimeAgo(timestamp: number): string {
        const diff = Math.max(0, Math.floor((Date.now() - timestamp) / 1000));
        if (diff < 60) return `${diff}s ago`;
        if (diff < 3600) return `${Math.floor(diff / 60)}m ago`;
        if (diff < 86400) return `${Math.floor(diff / 3600)}h ago`;
        return `${Math.floor(diff / 86400)}d ago`;
      }

      function formatExpires(expiresAt: number): { label: string; active: boolean } {
        const remaining = Math.floor((expiresAt - Date.now()) / 1000);
        if (remaining <= 0) return { label: "Expired", active: false };
        if (remaining < 3600) return { label: `${Math.max(1, Math.floor(remaining / 60))}m left`, active: true };
        if (remaining < 86400) return { label: `${(remaining / 3600).toFixed(1)}h left`, active: true };
        return { label: `${(remaining / 86400).toFixed(1)}d left`, active: true };
      }

      function graceInfo(log: LogRow): { text: string; cls: string } | null {
        if (log.expiresAt <= Date.now()) return null;
        if (log.graceActive) return { text: "Top 3", cls: "badge--grace" };
        if (log.ttlSeconds === 3600) return { text: "1h", cls: "badge--active" };
        if (log.ttlSeconds === 604800) return { text: "7d", cls: "badge--active" };
        return { text: "24h", cls: "badge--active" };
      }

      function cellText(text: string, sub?: string): HTMLTableCellElement {
        const td = document.createElement("td");
        const main = document.createElement("div");
        main.textContent = text;
        td.append(main);
        if (sub) {
          const s = document.createElement("span");
          s.className = "admin__table-sub";
          s.textContent = sub;
          td.append(s);
        }
        return td;
      }

      function badge(text: string, cls: string): HTMLSpanElement {
        const el = document.createElement("span");
        el.className = `badge ${cls}`;
        el.textContent = text;
        return el;
      }

      function actionButton(label: string, title: string, danger = false): HTMLButtonElement | HTMLAnchorElement {
        if (label === "Open") {
          const a = document.createElement("a");
          a.className = "btn-icon admin__btn-text";
          a.textContent = label;
          (a as HTMLElement).title = title;
          a.target = "_blank";
          a.rel = "noopener";
          return a;
        }
        const b = document.createElement("button");
        b.className = `btn-icon admin__btn-text${danger ? " btn-icon--danger" : ""}`;
        b.type = "button";
        b.textContent = label;
        b.title = title;
        b.setAttribute("aria-label", `${title}`);
        return b;
      }

      function renderRow(log: LogRow): HTMLTableRowElement {
        const tr = document.createElement("tr");
        const when = new Date(log.createdAt).toLocaleTimeString([], { hour: "2-digit", minute: "2-digit" });

        tr.append(cellText(formatTimeAgo(log.createdAt), when));

        // Site cell: slug link + meta line (all via textContent — XSS safe)
        const siteTd = document.createElement("td");
        const link = document.createElement("a");
        link.className = "admin__table-slug";
        link.href = `/s/${log.slug}/`;
        link.target = "_blank";
        link.rel = "noopener";
        link.textContent = `/s/${log.slug}/`;
        const meta = document.createElement("span");
        meta.className = "admin__table-sub";
        meta.textContent = `${log.homepage ?? "index.html"} • ${log.files ?? 1} file(s) • ${formatBytes(log.bytes ?? 0)}`;
        siteTd.append(link, meta);
        tr.append(siteTd);

        const srcTd = document.createElement("td");
        srcTd.append(badge(String(log.source ?? "website"), `badge--${log.source ?? "website"}`));
        tr.append(srcTd);

        const loc = [log.city, log.region, log.country].filter(Boolean).join(", ");
        tr.append(cellText(String(log.ip ?? "unknown"), loc || undefined));

        const visits = log.visits ?? 0;
        const lastVisit = log.lastVisitAt ? formatTimeAgo(log.lastVisitAt) : "never";
        tr.append(cellText(String(visits), `last ${lastVisit}`));

        const expTd = document.createElement("td");
        const exp = formatExpires(log.expiresAt);
        expTd.append(badge(exp.label, exp.active ? "badge--active" : "badge--expired"));
        const g = graceInfo(log);
        if (g) {
          expTd.append(document.createTextNode(" "));
          expTd.append(badge(g.text, g.cls));
        }
        tr.append(expTd);

        const actTd = document.createElement("td");
        actTd.className = "admin__cell-actions";
        const wrap = document.createElement("div");
        wrap.className = "admin__actions";
        const fullUrl = `${window.location.origin}/s/${log.slug}/`;
        const open = actionButton("Open", "Open site") as HTMLAnchorElement;
        open.href = `/s/${log.slug}/`;
        const copy = actionButton("Copy", "Copy URL") as HTMLButtonElement;
        copy.dataset.action = "copy";
        copy.dataset.slug = log.slug;
        const details = actionButton("Details", "View details") as HTMLButtonElement;
        details.dataset.action = "details";
        details.dataset.slug = log.slug;
        const del = actionButton("Delete", "Delete site", true) as HTMLButtonElement;
        del.dataset.action = "delete";
        del.dataset.slug = log.slug;
        // Stash full URL without inline handlers
        copy.dataset.url = fullUrl;
        wrap.append(open, copy, details, del);
        actTd.append(wrap);
        tr.append(actTd);

        return tr;
      }

      async function loadLogs() {
        const tbody = document.getElementById("logs-tbody");
        if (!tbody) return;
        const searchInput = document.getElementById("log-search") as HTMLInputElement | null;
        const sourceSelect = document.getElementById("log-source") as HTMLSelectElement | null;
        const statusSelect = document.getElementById("log-status") as HTMLSelectElement | null;

        const search = (searchInput?.value ?? "").trim();
        const source = sourceSelect?.value ?? "all";
        const status = statusSelect?.value ?? "all";

        const params = new URLSearchParams({ page: String(currentPage), limit: String(currentLimit) });
        if (search) params.set("search", search);
        if (source !== "all") params.set("source", source);
        if (status !== "all") params.set("status", status);
        if (graceOnly) params.set("grace", "1");

        try {
          const data = await apiJson(`/api/admin/logs?${params.toString()}`);
          const records = (data.records ?? []) as LogRow[];
          currentRecords = records;

          if (data.metrics) {
            const m = data.metrics;
            const set = (id: string, text: string) => {
              const el = document.getElementById(id);
              if (el) el.textContent = text;
            };
            set("metric-active", String(m.activeSites ?? 0));
            set("metric-total-uploads", `${m.totalUploads ?? 0} total uploads`);
            // Truthful meter: live bytes only.
            set("metric-storage", formatBytes(m.activeBytes ?? m.totalBytes ?? 0));
            set("metric-storage-sub", `${formatBytes(m.totalBytes ?? 0)} logged total · 500MB free tier`);
            set("metric-visits", String(m.totalVisits ?? 0));
            set("metric-cli-count", String(m.sources?.cli ?? 0));
            const webEl = document.getElementById("metric-web-count");
            if (webEl) webEl.textContent = `Web ${m.sources?.website ?? 0} · API ${m.sources?.api ?? 0}`;
          }

          tbody.textContent = "";
          if (records.length === 0) {
            const tr = document.createElement("tr");
            const td = document.createElement("td");
            td.colSpan = 7;
            td.className = "admin__table-state";
            td.textContent = "No uploads match these filters.";
            tr.append(td);
            tbody.append(tr);
          } else {
            records.forEach((log) => tbody.append(renderRow(log)));
          }

          const totalRecords = data.totalRecords ?? 0;
          const totalPages = data.totalPages ?? 1;
          const page = data.currentPage ?? 1;
          const startItem = totalRecords === 0 ? 0 : (page - 1) * currentLimit + 1;
          const endItem = Math.min(totalRecords, page * currentLimit);
          const info = document.getElementById("pagination-info");
          const pageNum = document.getElementById("current-page-num");
          const prevBtn = document.getElementById("prev-page-btn") as HTMLButtonElement | null;
          const nextBtn = document.getElementById("next-page-btn") as HTMLButtonElement | null;
          if (info) info.textContent = `Showing ${startItem}–${endItem} of ${totalRecords} items`;
          if (pageNum) pageNum.textContent = String(page);
          if (prevBtn) prevBtn.disabled = page <= 1;
          if (nextBtn) nextBtn.disabled = page >= totalPages;
        } catch {
          tbody.textContent = "";
          const tr = document.createElement("tr");
          const td = document.createElement("td");
          td.colSpan = 7;
          td.className = "admin__table-state--error";
          td.textContent = "Failed to load uploads. Check connection, then Refresh.";
          tr.append(td);
          tbody.append(tr);
        }
      }

      // Delegated row actions — no inline handlers.
      document.getElementById("logs-tbody")?.addEventListener("click", async (e) => {
        const btn = (e.target as HTMLElement).closest("[data-action]") as HTMLElement | null;
        if (!btn) return;
        const action = btn.dataset.action;
        const slug = btn.dataset.slug ?? "";
        if (!slug) return;
        if (action === "copy") {
          const url = btn.dataset.url ?? `${window.location.origin}/s/${slug}/`;
          try {
            await navigator.clipboard.writeText(url);
            flashButton(btn, "Copied");
          } catch { /* ignore */ }
        } else if (action === "details") {
          openDetails(slug);
        } else if (action === "delete") {
          await deleteSite(slug);
        }
      });

      async function deleteSite(slug: string) {
        if (!confirm(`Delete /s/${slug}/? Files are removed immediately; the log row is kept as history.`)) return;
        try {
          await apiJson("/api/admin/delete-site", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug }),
          });
          await loadLogs();
        } catch (err) {
          alert(err instanceof Error ? err.message : "Delete failed.");
        }
      }

      document.getElementById("purge-expired-btn")?.addEventListener("click", async (e) => {
        if (!confirm("Purge up to 50 expired sites (files + log rows)? Active sites are untouched.")) return;
        const btn = e.target as HTMLElement;
        const orig = btn.textContent;
        btn.textContent = "Purging…";
        try {
          const data = await apiJson("/api/admin/bulk-delete", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ expiredOnly: true }),
          });
          flashButton(btn, `Purged ${data.deletedCount ?? 0}`);
          currentPage = 1;
          await loadLogs();
        } catch (err) {
          alert(err instanceof Error ? err.message : "Purge failed.");
          btn.textContent = orig;
        }
      });

      // ---------- details modal ----------
      function openDetails(slug: string) {
        const record = currentRecords.find((r) => r.slug === slug);
        if (!record) return;
        modalSlug = slug;

        const summary = document.getElementById("modal-summary");
        if (summary) {
          summary.textContent = "";
          const loc = [record.city, record.region, record.country].filter(Boolean).join(", ") || "unknown";
          const rows: Array<[string, string]> = [
            ["Site", `/s/${record.slug}/`],
            ["Uploaded", new Date(record.createdAt).toLocaleString()],
            ["Expires", new Date(record.expiresAt).toLocaleString()],
            ["Client IP", String(record.ip ?? "unknown")],
            ["Location", loc],
            ["Source", String(record.source ?? "website")],
            ["User-Agent", String(record.userAgent ?? "—")],
            ["Files", `${record.files ?? 1} file(s) · ${formatBytes(record.bytes ?? 0)} · ${record.homepage ?? "index.html"}`],
            ["Visits", `${record.visits ?? 0} · last ${record.lastVisitAt ? new Date(record.lastVisitAt).toLocaleString() : "never"}`],
            ["TTL", record.ttlSeconds === 3600 ? "1 hour" : record.ttlSeconds === 604800 ? "7 days" : "24 hours"],
          ];
          rows.forEach(([k, v]) => {
            const wrap = document.createElement("div");
            const dt = document.createElement("dt");
            dt.textContent = k;
            const dd = document.createElement("dd");
            dd.textContent = v;
            wrap.append(dt, dd);
            summary.append(wrap);
          });
        }
        const code = document.getElementById("modal-json");
        if (code) code.textContent = JSON.stringify(record, null, 2);

        const select = document.getElementById("extend-select") as HTMLSelectElement | null;
        if (select && record.ttlSeconds) select.value = String(record.ttlSeconds);

        const modal = document.getElementById("details-modal");
        if (modal) {
          modal.removeAttribute("hidden");
          (document.getElementById("close-modal-btn") as HTMLButtonElement | null)?.focus();
        }
      }

      function closeModal() {
        const modal = document.getElementById("details-modal");
        if (modal) modal.setAttribute("hidden", "");
        modalSlug = null;
      }

      document.getElementById("close-modal-btn")?.addEventListener("click", closeModal);
      document.getElementById("details-modal")?.addEventListener("click", (e) => {
        if (e.target === document.getElementById("details-modal")) closeModal();
      });
      document.addEventListener("keydown", (e) => {
        if (e.key === "Escape" && !document.getElementById("details-modal")?.hasAttribute("hidden")) closeModal();
      });

      document.getElementById("modal-copy-btn")?.addEventListener("click", async (e) => {
        if (!modalSlug) return;
        try {
          await navigator.clipboard.writeText(`${window.location.origin}/s/${modalSlug}/`);
          flashButton(e.target as HTMLElement, "Copied");
        } catch { /* ignore */ }
      });

      document.getElementById("modal-delete-btn")?.addEventListener("click", async () => {
        if (!modalSlug) return;
        const slug = modalSlug;
        closeModal();
        await deleteSite(slug);
      });

      document.getElementById("extend-apply-btn")?.addEventListener("click", async (e) => {
        if (!modalSlug) return;
        const select = document.getElementById("extend-select") as HTMLSelectElement | null;
        const ttl = parseInt(select?.value ?? "", 10);
        if (ttl !== 3600 && ttl !== 86400 && ttl !== 604800) return;
        const btn = e.target as HTMLElement;
        btn.textContent = "Applying…";
        try {
          await apiJson("/api/admin/extend-site", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ slug: modalSlug, ttl }),
          });
          closeModal();
          await loadLogs();
        } catch (err) {
          alert(err instanceof Error ? err.message : "Extend failed.");
          btn.textContent = "Apply";
        }
      });

      // ---------- filters & pagination ----------
      let searchTimer: unknown;
      document.getElementById("log-search")?.addEventListener("input", () => {
        window.clearTimeout(searchTimer as number);
        searchTimer = window.setTimeout(() => {
          currentPage = 1;
          void loadLogs();
        }, 300);
      });
      document.getElementById("log-source")?.addEventListener("change", () => {
        currentPage = 1;
        void loadLogs();
      });
      document.getElementById("log-status")?.addEventListener("change", () => {
        currentPage = 1;
        void loadLogs();
      });
      document.getElementById("grace-filter-btn")?.addEventListener("click", (e) => {
        graceOnly = !graceOnly;
        const btn = e.target as HTMLElement;
        btn.setAttribute("aria-pressed", String(graceOnly));
        currentPage = 1;
        void loadLogs();
      });
      document.getElementById("log-limit")?.addEventListener("change", (e) => {
        currentLimit = parseInt((e.target as HTMLSelectElement).value, 10) || 10;
        currentPage = 1;
        void loadLogs();
      });
      document.getElementById("refresh-logs-btn")?.addEventListener("click", () => void loadLogs());
      document.getElementById("prev-page-btn")?.addEventListener("click", () => {
        if (currentPage > 1) {
          currentPage--;
          void loadLogs();
        }
      });
      document.getElementById("next-page-btn")?.addEventListener("click", () => {
        currentPage++;
        void loadLogs();
      });

      // ---------- init: honor deep link, default to uploads ----------
      if (document.getElementById("logs-tbody")) {
        const fromHash = location.hash.replace(/^#\/?/, "");
        activateTab(tabButtons.has(fromHash) ? fromHash : "logs", false);
      }
    </script>
  </body>
</html>
