---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "madethis.website · Temporary static hosting",
  description = "Drop a folder or file to get a live link instantly. Free temporary static hosting with no account, no build steps, and automatic expiration.",
} = Astro.props;

const SITE = "https://madethis.website";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={SITE + "/"} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={SITE + "/"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={SITE + "/og.svg"} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0d0e13" />
  </head>
  <body>
    <div class="site">
      <a class="sr-only" href="#main">Skip to content</a>

      <header class="nav" id="top">
        <div class="nav__inner">
          <a class="brand" href="/" aria-label="madethis.website home">
            <span class="brand__mark" aria-hidden="true">M</span>
            <span>made<span class="brand__accent">this</span>.website</span>
          </a>

          <nav aria-label="Main">
            <ul class="nav__links">
              <li><a href="#how">How it works</a></li>
              <li><a href="#why">Why temporary</a></li>
              <li><a href="#faq">FAQ</a></li>
            </ul>
          </nav>

          <a class="btn btn--primary nav__cta" href="#drop">Drop something</a>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>

      <footer class="footer">
        <div class="footer__inner">
          <div class="footer__note">
            made<span style="color: var(--amber)">this</span>.website · Drop it, share it, let it expire
          </div>
          <ul class="footer__links">
            <li><a href="#how">How it works</a></li>
            <li><a href="#faq">FAQ</a></li>
            <li><a href="https://github.com/dustindog101/madethis.website" rel="external">Source</a></li>
            <li><a href="/docs/api" class="footer__admin" aria-label="API docs">api</a></li>
            <li><a href="/admin" class="footer__admin" aria-label="Admin">·</a></li>
          </ul>
        </div>
      </footer>
    </div>

    <script>
      // nav border on scroll
      const nav = document.querySelector(".nav");
      const onScroll = () => nav?.classList.toggle("nav--scrolled", window.scrollY > 8);
      onScroll();
      addEventListener("scroll", onScroll, { passive: true });

      // Admin access shortcuts (triple-tap logo/footer, or Ctrl/Cmd + Shift + A)
      const triggerAdmin = () => {
        if ("vibrate" in navigator) {
          try {
            navigator.vibrate(60);
          } catch (_) {}
        }
        window.location.href = "/admin";
      };

      // 1. Triple-tap / click the logo
      let logoClicks = 0;
      let logoTimer: ReturnType<typeof setTimeout> | null = null;
      const brand = document.querySelector<HTMLAnchorElement>(".brand");

      brand?.addEventListener("click", (e) => {
        if (e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || (e.button && e.button !== 0)) {
          return;
        }
        logoClicks++;
        if (logoClicks >= 3) {
          e.preventDefault();
          if (logoTimer) clearTimeout(logoTimer);
          logoClicks = 0;
          triggerAdmin();
          return;
        }

        e.preventDefault();
        if (logoTimer) clearTimeout(logoTimer);
        logoTimer = setTimeout(() => {
          logoClicks = 0;
          if (window.location.pathname === "/" || window.location.pathname === "") {
            window.scrollTo({ top: 0, behavior: "smooth" });
          } else {
            window.location.href = "/";
          }
        }, 350);
      });

      // 2. Triple-tap / click footer note
      let footerClicks = 0;
      let footerTimer: ReturnType<typeof setTimeout> | null = null;
      const footerNote = document.querySelector(".footer__note");

      footerNote?.addEventListener("click", () => {
        footerClicks++;
        if (footerClicks >= 3) {
          if (footerTimer) clearTimeout(footerTimer);
          footerClicks = 0;
          triggerAdmin();
          return;
        }
        if (footerTimer) clearTimeout(footerTimer);
        footerTimer = setTimeout(() => {
          footerClicks = 0;
        }, 450);
      });

      // 3. Desktop hotkey: Cmd/Ctrl + Shift + A
      window.addEventListener("keydown", (e) => {
        if (
          e.target instanceof HTMLInputElement ||
          e.target instanceof HTMLTextAreaElement ||
          (e.target as HTMLElement)?.isContentEditable
        ) {
          return;
        }
        if ((e.metaKey || e.ctrlKey) && e.shiftKey && (e.key === "a" || e.key === "A")) {
          e.preventDefault();
          triggerAdmin();
        }
      });
    </script>
  </body>
</html>