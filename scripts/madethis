#!/usr/bin/env bash
# madethis.website CLI — upload HTML, Markdown, JS/CSS, or ZIP static sites.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: madethis upload <file> [options]

Environment:
  MADETHIS_API_KEY   API key from https://www.madethis.website/admin (after login)
  MADETHIS_URL       API base URL (default: https://www.madethis.website)

Options:
  --ttl 1h|24h       How long the site stays live (default: 24h)
  --name NAME        Filename inside the zip (for single-file uploads)
  --json             Print full JSON response
  -h, --help         Show this help

Supported files:
  .html .htm .md .js .mjs .css .png .jpg .jpeg .gif .webp .svg .avif .zip (full static sites)

Examples:
  madethis upload demo.html --ttl 1h
  madethis upload screenshot.png
  madethis upload notes.md
  madethis upload app.js
  madethis upload dist.zip
EOF
}

BASE_URL="${MADETHIS_URL:-https://www.madethis.website}"
TTL="86400"
FILENAME=""
JSON_OUT=0
FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    upload)
      shift
      [[ $# -gt 0 ]] || { echo "error: missing file after upload" >&2; exit 1; }
      FILE="$1"
      shift
      ;;
    --ttl)
      shift
      case "${1:-}" in
        1h|3600) TTL="3600" ;;
        24h|86400|1d) TTL="86400" ;;
        *) echo "error: --ttl must be 1h or 24h" >&2; exit 1 ;;
      esac
      shift
      ;;
    --name)
      shift
      FILENAME="${1:-}"
      shift
      ;;
    --json) JSON_OUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [[ -z "$FILE" && -f "$1" ]]; then
        FILE="$1"
        shift
      else
        echo "error: unknown argument: $1" >&2
        usage >&2
        exit 1
      fi
      ;;
  esac
done

if [[ -z "${MADETHIS_API_KEY:-}" ]]; then
  echo "error: set MADETHIS_API_KEY — log in at ${BASE_URL}/admin to get one" >&2
  exit 1
fi

if [[ -z "$FILE" || ! -f "$FILE" ]]; then
  echo "error: provide a readable file" >&2
  usage >&2
  exit 1
fi

EXT="${FILE##*.}"
EXT_LOWER="$(printf '%s' "$EXT" | tr '[:upper:]' '[:lower:]')"
case "$EXT_LOWER" in
  zip) CT="application/zip" ;;
  md|markdown) CT="text/markdown; charset=utf-8" ;;
  html|htm) CT="text/html; charset=utf-8" ;;
  js|mjs) CT="text/javascript; charset=utf-8" ;;
  css) CT="text/css; charset=utf-8" ;;
  png) CT="image/png" ;;
  jpg|jpeg) CT="image/jpeg" ;;
  gif) CT="image/gif" ;;
  webp) CT="image/webp" ;;
  svg) CT="image/svg+xml" ;;
  avif) CT="image/avif" ;;
  ico) CT="image/x-icon" ;;
  bmp) CT="image/bmp" ;;
  *) CT="application/octet-stream" ;;
esac

HEADERS=(-H "Authorization: Bearer ${MADETHIS_API_KEY}" -H "Content-Type: ${CT}")
if [[ -n "$FILENAME" ]]; then
  HEADERS+=(-H "X-Filename: ${FILENAME}")
elif [[ -z "$FILENAME" ]]; then
  HEADERS+=(-H "X-Filename: $(basename "$FILE")")
fi

RESP="$(curl -fsS -X POST "${BASE_URL}/api/cli/upload?ttl=${TTL}" "${HEADERS[@]}" --data-binary @"${FILE}")"

if [[ "$JSON_OUT" -eq 1 ]]; then
  echo "$RESP"
  exit 0
fi

URL="$(printf '%s' "$RESP" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("fullUrl",""))')"
if [[ -z "$URL" ]]; then
  URL="$(printf '%s' "$RESP" | sed -n 's/.*"fullUrl":"\([^"]*\)".*/\1/p')"
fi

if [[ -z "$URL" ]]; then
  echo "$RESP"
  exit 0
fi

echo "$URL"
