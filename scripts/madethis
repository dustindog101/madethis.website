#!/usr/bin/env bash
# madethis.website CLI — upload HTML, Markdown, JS/CSS, or ZIP static sites.
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: madethis upload <file> [options]
       madethis <file> [options]

Environment:
  MADETHIS_API_KEY   API key from https://www.madethis.website/admin (default: configured system key)
  MADETHIS_URL       API base URL (default: https://www.madethis.website)

Options:
  --ttl 1h|24h       How long the site stays live (default: 24h)
  --name NAME        Filename inside the zip / custom filename
  --json             Print full JSON response
  -h, --help         Show this help

Supported files:
  .html .htm .md .js .mjs .css .png .jpg .jpeg .gif .webp .svg .avif .pdf .mp4 .webm .mov .zip (full static sites)

Examples:
  madethis upload demo.html --ttl 1h
  madethis upload screenshot.png
  madethis my_plan.html
  madethis upload dist.zip
EOF
}

if [[ -z "${MADETHIS_URL:-}" ]]; then
  if curl -s --connect-timeout 0.5 http://localhost:4321 >/dev/null 2>&1; then
    BASE_URL="http://localhost:4321"
  else
    BASE_URL="https://www.madethis.website"
  fi
else
  BASE_URL="$MADETHIS_URL"
fi
DEFAULT_KEY="8d6a7f7e482e1ecb8ab76c1938ebb65dd264a4e18ed0b5e1f00c12eeca8eb545"
API_KEY="${MADETHIS_API_KEY:-$DEFAULT_KEY}"
TTL="86400"
FILENAME=""
SLUG=""
JSON_OUT=0
FILE=""

while [[ $# -gt 0 ]]; do
  case "$1" in
    upload)
      shift
      [[ $# -gt 0 ]] || { echo "error: missing file after upload command" >&2; exit 1; }
      FILE="$1"
      shift
      ;;
    --ttl)
      shift
      case "${1:-}" in
        1h|3600) TTL="3600" ;;
        24h|86400|1d) TTL="86400" ;;
        7d|604800|7days|1w) TTL="604800" ;;
        *) echo "error: --ttl must be 1h, 24h, or 7d" >&2; exit 1 ;;
      esac
      shift
      ;;
    --slug)
      shift
      SLUG="${1:-}"
      shift
      ;;
    --name)
      shift
      FILENAME="${1:-}"
      shift
      ;;
    --json) JSON_OUT=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *)
      if [[ -z "$FILE" && -f "$1" ]]; then
        FILE="$1"
        shift
      else
        echo "error: unknown argument or file not found: $1" >&2
        usage >&2
        exit 1
      fi
      ;;
  esac
done

if [[ -z "$FILE" ]]; then
  echo "error: no file specified to upload" >&2
  usage >&2
  exit 1
fi

if [[ ! -f "$FILE" ]]; then
  echo "error: file not found or not readable: $FILE" >&2
  exit 1
fi

EXT="${FILE##*.}"
EXT_LOWER="$(printf '%s' "$EXT" | tr '[:upper:]' '[:lower:]')"
case "$EXT_LOWER" in
  zip) CT="application/zip" ;;
  md|markdown) CT="text/markdown; charset=utf-8" ;;
  html|htm) CT="text/html; charset=utf-8" ;;
  js|mjs) CT="text/javascript; charset=utf-8" ;;
  css) CT="text/css; charset=utf-8" ;;
  png) CT="image/png" ;;
  jpg|jpeg) CT="image/jpeg" ;;
  gif) CT="image/gif" ;;
  webp) CT="image/webp" ;;
  svg) CT="image/svg+xml" ;;
  avif) CT="image/avif" ;;
  ico) CT="image/x-icon" ;;
  bmp) CT="image/bmp" ;;
  mp4) CT="video/mp4" ;;
  webm) CT="video/webm" ;;
  mov) CT="video/quicktime" ;;
  m4v) CT="video/mp4" ;;
  ogg|ogv) CT="video/ogg" ;;
  pdf) CT="application/pdf" ;;
  *) CT="application/octet-stream" ;;
esac

HEADERS=(-H "Authorization: Bearer ${API_KEY}" -H "Content-Type: ${CT}")
if [[ -n "$SLUG" ]]; then
  HEADERS+=(-H "X-Slug: ${SLUG}")
fi
if [[ -n "$FILENAME" ]]; then
  HEADERS+=(-H "X-Filename: ${FILENAME}")
else
  HEADERS+=(-H "X-Filename: $(basename "$FILE")")
fi

# Execute upload and capture HTTP status code along with body
RESPONSE_WITH_CODE=$(curl -s -w "\n%{http_code}" -X POST "${BASE_URL}/api/cli/upload?ttl=${TTL}" "${HEADERS[@]}" --data-binary @"${FILE}")

HTTP_CODE=$(echo "$RESPONSE_WITH_CODE" | tail -n 1)
RESP=$(echo "$RESPONSE_WITH_CODE" | sed '$d')

if [[ "$HTTP_CODE" -lt 200 || "$HTTP_CODE" -ge 300 ]]; then
  echo "error: upload failed with HTTP $HTTP_CODE" >&2
  if [[ -n "$RESP" ]]; then
    echo "$RESP" >&2
  fi
  exit 1
fi

if [[ "$JSON_OUT" -eq 1 ]]; then
  echo "$RESP"
  exit 0
fi

# Extract fullUrl
URL="$(printf '%s' "$RESP" | python3 -c 'import json,sys; d=json.load(sys.stdin); print(d.get("fullUrl",""))' 2>/dev/null || true)"
if [[ -z "$URL" ]]; then
  URL="$(printf '%s' "$RESP" | sed -n 's/.*"fullUrl":"\([^"]*\)".*/\1/p')"
fi

if [[ -z "$URL" ]]; then
  # Fallback to printing response if fullUrl could not be extracted
  echo "$RESP"
  exit 0
fi

echo "$URL"
