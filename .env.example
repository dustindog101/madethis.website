# Cloudflare R2 Storage (Primary)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
R2_BUCKET_NAME=madethis-uploads

# Legacy / fallback: Vercel Blob (used only if R2 credentials are not set)
BLOB_READ_WRITE_TOKEN=
# optional: protect the cleanup cron (set in Vercel dashboard if you want it)
CRON_SECRET=
# Admin login — only env var required for /admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
# optional: override auto-derived session signing secret (32+ chars)
SESSION_SECRET=
# optional legacy env key — blob-stored key from /admin is preferred
CLI_API_KEY=
# optional: salt for hashed IP rate-limit keys
RATE_LIMIT_SALT=
